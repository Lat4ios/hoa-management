<%
    const php = n => '₱' + parseFloat(n || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
%>

<div class="rpt-actions no-print">
    <a href="/reports" class="rpt-back"><i class="fa-solid fa-arrow-left"></i> Back to Reports</a>
    <div style="display:flex; gap:10px;">
        <button onclick="exportCSV()" class="rpt-print-btn" style="background:#4a7c59;">
            <i class="fa-solid fa-file-csv"></i> Export CSV
        </button>
        <button onclick="window.print()" class="rpt-print-btn">
            <i class="fa-solid fa-print"></i> Print / Save as PDF
        </button>
    </div>
</div>

<div class="rpt-filter-bar no-print">
    <form id="dateFilterForm" method="GET" action="/reports/financials">
        <label>Report Period:</label>
        <input type="date" id="filterFrom" name="from" value="<%= fromDate %>" class="rpt-date-input">
        <span>to</span>
        <input type="date" id="filterTo" name="to" value="<%= toDate %>" class="rpt-date-input">
        <button type="submit" class="rpt-apply-btn">
            <i class="fa-solid fa-rotate-right"></i> Apply
        </button>
        <span id="dateError" style="color:#c00;font-size:12px;display:none;"></span>
    </form>
</div>
<script>
(function () {
    const today  = new Date().toISOString().slice(0, 10);
    const fromEl = document.getElementById('filterFrom');
    const toEl   = document.getElementById('filterTo');
    const errEl  = document.getElementById('dateError');

    fromEl.max = today;
    toEl.max   = today;

    function showErr(msg) { errEl.textContent = msg; errEl.style.display = 'inline'; }
    function clearErr()   { errEl.style.display = 'none'; }

    fromEl.addEventListener('change', function () { toEl.min = this.value; clearErr(); });
    toEl.addEventListener('change',   function () { fromEl.max = this.value < today ? this.value : today; clearErr(); });

    document.getElementById('dateFilterForm').addEventListener('submit', function (e) {
        const from = fromEl.value, to = toEl.value;
        if (!from || !to)            { e.preventDefault(); showErr('Both dates are required.'); return; }
        if (from > today || to > today) { e.preventDefault(); showErr('Dates cannot be in the future.'); return; }
        if (from > to)               { e.preventDefault(); showErr('"From" date must be on or before the "To" date.'); return; }
        clearErr();
    });
})();
</script>

<div class="rpt-page">

    <h1 class="rpt-main-title">FINANCIALS REPORT</h1>

    <div class="rpt-meta">
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT NAME:</span>
            <span>MARCELO GREEN VILLAGE PHASE 5 ANNUAL FINANCIALS REPORT</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT PERIOD:</span>
            <span><%= fromDateDisplay %> — <%= toDateDisplay %></span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT GENERATION DATE:</span>
            <span><%= generatedDate %></span>
        </div>
    </div>

    <!-- SUMMARY BOX -->
    <div class="rpt-summary-box">
        <div class="rpt-summary-label">SUMMARY</div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL COLLECTIONS</span>
            <span class="rpt-summary-val"><%= php(totalCollections) %></span>
        </div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL EXPENSES</span>
            <span class="rpt-summary-val"><%= php(totalExpenses) %></span>
        </div>
        <div class="rpt-summary-row" style="border-top:1.5px solid #333;margin-top:6px;padding-top:6px;">
            <span class="rpt-summary-key">ENDING BALANCE</span>
            <span class="rpt-summary-val" style="<%= endingBalance >= 0 ? 'color:#2e7d32;' : 'color:#c00;' %>">
                <%= php(endingBalance) %>
            </span>
        </div>
    </div>

    <!-- COLLECTIONS -->
    <h2 class="rpt-section-title">Collections</h2>
    <table class="rpt-table vgr-table">
        <thead>
            <tr>
                <th style="text-align:left;">Category</th>
                <th style="text-align:right;">Amount Collected</th>
            </tr>
        </thead>
        <tbody>
            <% collections.forEach(row => { %>
            <tr>
                <td><%= row.purpose %></td>
                <td style="text-align:right;"><%= php(row.total) %></td>
            </tr>
            <% }) %>
        </tbody>
        <tfoot>
            <tr style="font-weight:700;background:#f8f9fa;">
                <td>TOTAL</td>
                <td style="text-align:right;"><%= php(totalCollections) %></td>
            </tr>
        </tfoot>
    </table>

    <!-- EXPENSES -->
    <h2 class="rpt-section-title" style="margin-top:32px;">Expenses</h2>
    <table class="rpt-table vgr-table">
        <thead>
            <tr>
                <th style="text-align:left;">Category</th>
                <th style="text-align:right;">Amount Spent</th>
            </tr>
        </thead>
        <tbody>
            <% expenses.forEach(row => { %>
            <tr>
                <td><%= row.purpose %></td>
                <td style="text-align:right;"><%= php(row.total) %></td>
            </tr>
            <% }) %>
        </tbody>
        <tfoot>
            <tr style="font-weight:700;background:#f8f9fa;">
                <td>TOTAL</td>
                <td style="text-align:right;"><%= php(totalExpenses) %></td>
            </tr>
        </tfoot>
    </table>

    <!-- MONTHLY BREAKDOWN -->
    <h2 class="rpt-section-title" style="margin-top:32px;">Monthly Breakdown</h2>
    <table class="rpt-table vgr-table">
        <thead>
            <tr>
                <th style="text-align:left;">Month</th>
                <th style="text-align:right;">Collections</th>
                <th style="text-align:right;">Expenses</th>
                <th style="text-align:right;">Net</th>
            </tr>
        </thead>
        <tbody>
            <% monthly.forEach(row => { %>
            <tr>
                <td><%= row.label %></td>
                <td style="text-align:right;"><%= php(row.collections) %></td>
                <td style="text-align:right;"><%= php(row.expenses) %></td>
                <td style="text-align:right;<%= (row.collections - row.expenses) >= 0 ? 'color:#2e7d32;' : 'color:#c00;' %>">
                    <%= php(row.collections - row.expenses) %>
                </td>
            </tr>
            <% }) %>
        </tbody>
        <tfoot>
            <tr style="font-weight:700;background:#f8f9fa;">
                <td>TOTAL</td>
                <td style="text-align:right;"><%= php(totalCollections) %></td>
                <td style="text-align:right;"><%= php(totalExpenses) %></td>
                <td style="text-align:right;<%= endingBalance >= 0 ? 'color:#2e7d32;' : 'color:#c00;' %>">
                    <%= php(endingBalance) %>
                </td>
            </tr>
        </tfoot>
    </table>

</div>

<script id="reportData" type="application/json"><%- JSON.stringify({
    fromDateDisplay, toDateDisplay, collections, expenses, totalCollections, totalExpenses, endingBalance, monthly
}) %></script>
<script>
function exportCSV() {
    const d = JSON.parse(document.getElementById('reportData').textContent);
    const { fromDateDisplay, toDateDisplay, collections, expenses, totalCollections, totalExpenses, endingBalance, monthly } = d;

    const esc = val => '"' + String(val ?? '').replace(/"/g, '""') + '"';
    const php = n => '₱' + parseFloat(n || 0).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    const lines = [];

    lines.push(esc('FINANCIALS REPORT'));
    lines.push([esc('Report Period'), esc(`${fromDateDisplay} — ${toDateDisplay}`)].join(','));
    lines.push('');

    lines.push(esc('SUMMARY'));
    lines.push([esc('Metric'), esc('Amount')].join(','));
    lines.push([esc('Total Collections'), esc(php(totalCollections))].join(','));
    lines.push([esc('Total Expenses'),    esc(php(totalExpenses))].join(','));
    lines.push([esc('Ending Balance'),    esc(php(endingBalance))].join(','));
    lines.push('');

    lines.push(esc('COLLECTIONS'));
    lines.push([esc('Category'), esc('Amount Collected')].join(','));
    collections.forEach(r => lines.push([esc(r.purpose), esc(php(r.total))].join(',')));
    lines.push([esc('TOTAL'), esc(php(totalCollections))].join(','));
    lines.push('');

    lines.push(esc('EXPENSES'));
    lines.push([esc('Category'), esc('Amount Spent')].join(','));
    expenses.forEach(r => lines.push([esc(r.purpose), esc(php(r.total))].join(',')));
    lines.push([esc('TOTAL'), esc(php(totalExpenses))].join(','));
    lines.push('');

    lines.push(esc('MONTHLY BREAKDOWN'));
    lines.push([esc('Month'), esc('Collections'), esc('Expenses'), esc('Net')].join(','));
    monthly.forEach(r => {
        lines.push([
            esc(r.label),
            esc(php(r.collections)),
            esc(php(r.expenses)),
            esc(php(r.collections - r.expenses)),
        ].join(','));
    });
    lines.push([esc('TOTAL'), esc(php(totalCollections)), esc(php(totalExpenses)), esc(php(endingBalance))].join(','));

    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = 'financials_report.csv';
    a.click();
    URL.revokeObjectURL(url);
}
</script>
