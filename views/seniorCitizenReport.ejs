<%
    const fmtDate = (dateStr) => {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('en-PH', {
            month: 'long', day: 'numeric', year: 'numeric',
        });
    };

    const calcAge = (dateStr) => {
        if (!dateStr) return '—';
        const birth = new Date(dateStr);
        const now   = new Date();
        let age = now.getFullYear() - birth.getFullYear();
        const m = now.getMonth() - birth.getMonth();
        if (m < 0 || (m === 0 && now.getDate() < birth.getDate())) age--;
        return age;
    };

    const activeSeniors   = rows.filter(r => r.category === 'active_senior');
    const inactiveSeniors = rows.filter(r => r.category === 'inactive_senior');
    const turning60       = rows.filter(r => r.category === 'turning_60');
%>

<div class="rpt-actions no-print">
    <a href="/reports" class="rpt-back"><i class="fa-solid fa-arrow-left"></i> Back to Reports</a>
    <div style="display:flex; gap:10px;">
        <button onclick="exportCSV()" class="rpt-print-btn" style="background:#4a7c59;">
            <i class="fa-solid fa-file-csv"></i> Export CSV
        </button>
        <button onclick="window.print()" class="rpt-print-btn">
            <i class="fa-solid fa-print"></i> Print / Save as PDF
        </button>
    </div>
</div>

<div class="rpt-page">

    <h1 class="rpt-main-title">SENIOR CITIZEN REPORT</h1>

    <div class="rpt-meta">
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT NAME:</span>
            <span>MARCELO GREEN VILLAGE PHASE 5 HOA SENIOR CITIZEN REPORT</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT PERIOD:</span>
            <span>AS OF CURRENT DATE</span>
        </div>
        <div class="rpt-meta-row">
            <span class="rpt-meta-label">REPORT GENERATION DATE:</span>
            <span><%= generatedDate %></span>
        </div>
    </div>

    <div class="rpt-summary-box">
        <div class="rpt-summary-label">SUMMARY</div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">TOTAL SENIOR CITIZENS (60+)</span>
            <span class="rpt-summary-val"><%= summary.totalSeniors %></span>
            <span class="rpt-summary-breakdown">
                BREAKDOWN: &nbsp; ACTIVE <%= summary.activeCount %> &nbsp;&nbsp; INACTIVE <%= summary.inactiveCount %>
            </span>
        </div>
        <div class="rpt-summary-row">
            <span class="rpt-summary-key">RESIDENTS TURNING 60 WITHIN THE NEXT YEAR</span>
            <span class="rpt-summary-val"><%= summary.turningCount %></span>
        </div>
    </div>

    <!-- ACTIVE SENIORS -->
    <h2 class="rpt-section-title">Active Senior Citizens</h2>
    <table class="rpt-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Birth Date</th>
                <th>Age</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
            <% if (activeSeniors.length === 0) { %>
            <tr>
                <td colspan="4" style="text-align:center;padding:16px;color:#999;">No active senior citizens found.</td>
            </tr>
            <% } else { %>
                <% activeSeniors.forEach(row => { %>
                <tr>
                    <td><%= row.full_name %></td>
                    <td><%= fmtDate(row.birth_date) %></td>
                    <td><%= calcAge(row.birth_date) %></td>
                    <td><%= row.address %></td>
                </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

    <!-- INACTIVE SENIORS -->
    <h2 class="rpt-section-title" style="margin-top:32px;">Inactive Senior Citizens</h2>
    <table class="rpt-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Birth Date</th>
                <th>Age</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
            <% if (inactiveSeniors.length === 0) { %>
            <tr>
                <td colspan="4" style="text-align:center;padding:16px;color:#999;">No inactive senior citizens found.</td>
            </tr>
            <% } else { %>
                <% inactiveSeniors.forEach(row => { %>
                <tr>
                    <td><%= row.full_name %></td>
                    <td><%= fmtDate(row.birth_date) %></td>
                    <td><%= calcAge(row.birth_date) %></td>
                    <td><%= row.address %></td>
                </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

    <!-- TURNING 60 -->
    <h2 class="rpt-section-title" style="margin-top:32px;">Residents Turning 60 Within the Next Year</h2>
    <table class="rpt-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Birth Date</th>
                <th>Current Age</th>
                <th>Turns 60 On</th>
                <th>Address</th>
            </tr>
        </thead>
        <tbody>
            <% if (turning60.length === 0) { %>
            <tr>
                <td colspan="5" style="text-align:center;padding:16px;color:#999;">No residents turning 60 within the next year.</td>
            </tr>
            <% } else { %>
                <% turning60.forEach(row => { %>
                <%
                    const bday = new Date(row.birth_date);
                    const turns60 = new Date(bday.getFullYear() + 60, bday.getMonth(), bday.getDate());
                    const turns60Str = turns60.toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
                %>
                <tr>
                    <td><%= row.full_name %></td>
                    <td><%= fmtDate(row.birth_date) %></td>
                    <td><%= calcAge(row.birth_date) %></td>
                    <td><%= turns60Str %></td>
                    <td><%= row.address %></td>
                </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>

</div>

<script id="reportRowsData"    type="application/json"><%- JSON.stringify(rows)    %></script>
<script id="reportSummaryData" type="application/json"><%- JSON.stringify(summary) %></script>
<script>
function exportCSV() {
    const rows    = JSON.parse(document.getElementById('reportRowsData').textContent);
    const summary = JSON.parse(document.getElementById('reportSummaryData').textContent);

    const esc = val => '"' + String(val ?? '').replace(/"/g, '""') + '"';

    const fmtDate = dateStr => {
        if (!dateStr) return '';
        return new Date(dateStr).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
    };

    const calcAge = dateStr => {
        if (!dateStr) return '';
        const birth = new Date(dateStr), now = new Date();
        let age = now.getFullYear() - birth.getFullYear();
        const m = now.getMonth() - birth.getMonth();
        if (m < 0 || (m === 0 && now.getDate() < birth.getDate())) age--;
        return age;
    };

    const turns60Date = dateStr => {
        if (!dateStr) return '';
        const b = new Date(dateStr);
        const d = new Date(b.getFullYear() + 60, b.getMonth(), b.getDate());
        return d.toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
    };

    const lines = [];

    // Summary section
    lines.push(esc('SUMMARY'));
    lines.push([esc('Metric'), esc('Value')].join(','));
    lines.push([esc('Total Senior Citizens (60+)'),              esc(summary.totalSeniors)].join(','));
    lines.push([esc('Active Senior Citizens'),                   esc(summary.activeCount)].join(','));
    lines.push([esc('Inactive Senior Citizens'),                 esc(summary.inactiveCount)].join(','));
    lines.push([esc('Residents Turning 60 Within the Next Year'), esc(summary.turningCount)].join(','));
    lines.push('');

    // Active seniors
    const activeSeniors   = rows.filter(r => r.category === 'active_senior');
    const inactiveSeniors = rows.filter(r => r.category === 'inactive_senior');
    const turning60       = rows.filter(r => r.category === 'turning_60');

    const seniorCols = ['Name', 'Birth Date', 'Age', 'Address'].map(esc).join(',');

    lines.push(esc('ACTIVE SENIOR CITIZENS'));
    lines.push(seniorCols);
    activeSeniors.forEach(r => lines.push([esc(r.full_name), esc(fmtDate(r.birth_date)), esc(calcAge(r.birth_date)), esc(r.address)].join(',')));
    lines.push('');

    lines.push(esc('INACTIVE SENIOR CITIZENS'));
    lines.push(seniorCols);
    inactiveSeniors.forEach(r => lines.push([esc(r.full_name), esc(fmtDate(r.birth_date)), esc(calcAge(r.birth_date)), esc(r.address)].join(',')));
    lines.push('');

    lines.push(esc('RESIDENTS TURNING 60 WITHIN THE NEXT YEAR'));
    lines.push(['Name', 'Birth Date', 'Current Age', 'Turns 60 On', 'Address'].map(esc).join(','));
    turning60.forEach(r => lines.push([esc(r.full_name), esc(fmtDate(r.birth_date)), esc(calcAge(r.birth_date)), esc(turns60Date(r.birth_date)), esc(r.address)].join(',')));

    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = 'senior_citizen_report.csv';
    a.click();
    URL.revokeObjectURL(url);
}
</script>
