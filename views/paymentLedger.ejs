<div class="main-wrapper">
    <div class="sidebar-open nav-item">
        <i class="fa-solid fa-bars"></i>
        <span>Open Sidebar</span>
    </div>

    <header class="topbar">
        <div class="topbar-left">
            <h1 class="page-title">Payment Ledger</h1>
            <p class="page-subtitle">Manage expense and payment transactions</p>
        </div>
        <div class="topbar-right">
            <div class="topbar-user">
                <div class="user-avatar"><i class="fa-solid fa-user"></i></div>
                <div class="user-info">
                    <span class="user-name">Village Admin</span>
                    <span class="user-role">Administrator</span>
                </div>
            </div>
        </div>
    </header>

    <main class="content">
        <!-- ALERTS -->
        <% if (success) { %>
            <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> <%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="alert alert-error"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
        <% } %>

        <!-- TAB NAVIGATION -->
        <div class="tab-bar">
            <button id="btnPaymentsTab" class="tab-btn tab-active" onclick="switchTab('payments')">
                <i class="fa-solid fa-wallet"></i>  Payments
            </button>
            <button id="btnExpensesTab" class="tab-btn" onclick="switchTab('expenses')">
                <i class="fa-solid fa-file-invoice-dollar"></i>  Expenses
            </button>
        </div>

        <!-- SHARED ACTION BAR -->
        <div class="action-bar">
            <div style="display:flex; align-items:center; gap:10px;">
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" class="search-input" id="searchInput"
                        placeholder="Search transactions..."
                        oninput="filterTable()">
                </div>

                <!-- PURPOSE FILTER -->
                <form id="purposeFilterForm" method="GET" action="/payments" style="display:flex; align-items:center;">
                    <select name="purpose" class="form-control" style="width:auto;"
                            onchange="document.getElementById('purposeFilterForm').submit()">
                        <option value="">All Purposes</option>
                        <% const purposes = ['Vehicle Sticker','Association Dues','Outstanding Balance','General Payments']; %>
                        <% purposes.forEach(p => { %>
                            <option value="<%= p %>" <%= filterPurpose === p ? 'selected' : '' %>><%= p %></option>
                        <% }) %>
                    </select>
                </form>
            </div>

            <div>
                <button class="btn btn-primary" id="openExpenseModal">
                    <i class="fa-solid fa-plus"></i> Add Expense
                </button>
                <button class="btn btn-primary" id="openModal">
                    <i class="fa-solid fa-plus"></i> Add Payment
                </button>
            </div>
        </div>

        <!-- PAYMENTS -->
        <div id="paymentsSection">
            <!-- STATUS FILTER -->
            <div class="status-filter-bar">
                <button class="pay-filter-btn pay-filter-active" onclick="setStatusFilter('all', this)">All</button>
                <button class="pay-filter-btn" onclick="setStatusFilter('paid', this)">Paid</button>
                <button class="pay-filter-btn" onclick="setStatusFilter('partial', this)">Partial</button>
                <button class="pay-filter-btn" onclick="setStatusFilter('unpaid', this)">Unpaid</button>
            </div>

            <!-- PAYMENT COUNTER -->
            <p class="payment-count" id="paymentCount">
                Showing <strong id="visibleCount"><%= payments.length %></strong> payment<%= payments.length !== 1 ? 's' : '' %>
                <% if (filterPurpose) { %> &mdash; filtered by <em><%= filterPurpose %></em><% } %>
            </p>

            <!-- DATA TABLE -->
            <div class="table-container">
                <table class="data-table" id="paymentTable">
                    <thead>
                        <tr>
                            <th>Date Paid</th>
                            <th>Payor</th>
                            <th>Purpose</th>
                            <th>Expected</th>
                            <th>Paid</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (payments.length === 0) { %>
                            <tr>
                                <td colspan="8" class="empty-state">
                                    No payment records found. Click "Add Payment" to create one.
                                </td>
                            </tr>
                        <% } else { %>
                            <% payments.forEach(function(pay) {
                                let status = 'Unpaid';
                                let statusClass = 'status-unpaid';
                                if (parseFloat(pay.amount_paid) > 0) {
                                    if (parseFloat(pay.amount_paid) >= parseFloat(pay.amount_expected)) {
                                        status = 'Paid';
                                        statusClass = 'status-paid';
                                    } else {
                                        status = 'Partial';
                                        statusClass = 'status-partial';
                                    }
                                }
                                const datePaid = pay.date_paid
                                    ? new Date(pay.date_paid).toLocaleDateString('en-PH', { year:'numeric', month:'short', day:'numeric' })
                                    : '—';
                            %>
                            <tr data-status="<%= status.toLowerCase() %>">
                                <td><%= datePaid %></td>
                                <td><%= pay.payer_name || '—' %></td>
                                <td><span class="purpose-badge"><%= pay.purpose %></span></td>
                                <td>&#8369; <%= parseFloat(pay.amount_expected).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
                                <td>&#8369; <%= parseFloat(pay.amount_paid).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
                                <td><%= pay.payment_method %></td>
                                <td><span class="payment-status <%= statusClass %>"><%= status %></span></td>
                                <td style="display:flex; gap:6px; align-items:center;">
                                    <button class="btn-icon" title="View Details" onclick="openViewModal(this)"
                                            data-id="<%= pay.payment_id %>" data-payor="<%= pay.payer_name || '' %>"
                                            data-purpose="<%= pay.purpose %>" data-expected="<%= pay.amount_expected %>"
                                            data-paid="<%= pay.amount_paid %>" data-date="<%= pay.date_paid || '' %>"
                                            data-method="<%= pay.payment_method %>" data-receipt="<%= pay.receipt_number || '' %>"
                                            data-remarks="<%= pay.remarks || '' %>">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn-icon" title="Edit" onclick="openEditModal(this)"
                                            data-id="<%= pay.payment_id %>" data-purpose="<%= pay.purpose %>"
                                            data-expected="<%= pay.amount_expected %>" data-paid="<%= pay.amount_paid %>"
                                            data-date="<%= pay.date_paid || '' %>" data-method="<%= pay.payment_method %>"
                                            data-receipt="<%= pay.receipt_number || '' %>" data-remarks="<%= pay.remarks || '' %>"
                                            data-paidby="<%= pay.paid_by || '' %>">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button class="btn-icon btn-icon-danger" title="Delete" onclick="confirmDelete(this.dataset.id, this.dataset.label)"
                                            data-id="<%= pay.payment_id %>" data-label="<%= pay.payer_name || pay.purpose %>">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- EXPENSES -->
        <div id="expensesSection" style="display: none;">
            <p class="payment-count">Showing <strong><%= expenses.length %></strong> expense<%= expenses.length !== 1 ? 's' : '' %></p>
            
            <div class="table-container">
                <table class="data-table" id="expenseTable">
                    <thead>
                        <tr>
                            <th>Date Paid</th>
                            <th>Payor</th>
                            <th>Category</th>
                            <th>Expected</th>
                            <th>Paid</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (expenses.length === 0) { %>
                            <tr><td colspan="8" class="empty-state">No expense records found.</td></tr>
                        <% } else { %>
                                <% expenses.forEach(function(exp) { 
                                let status = parseFloat(exp.amount_paid) >= parseFloat(exp.amount_expected) ? 'Paid' : 'Partial';
                                let statusClass = status === 'Paid' ? 'status-paid' : 'status-partial';
                                
                                const d = new Date(exp.date_paid);
                                
                                const datePaidDisplay = !isNaN(d) ? d.toLocaleDateString('en-PH', { year:'numeric', month:'short', day:'numeric' }) : '—';
                                
                                const datePaidForm = !isNaN(d) ? d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0') : '';
                            %>
                            <tr>
                                <td><%= datePaidDisplay %></td>
                                <td><%= exp.payor_name || '—' %></td>
                                <td><span class="purpose-badge" style="text-transform: capitalize;"><%= exp.category %></span></td>
                                <td>&#8369; <%= parseFloat(exp.amount_expected).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
                                <td>&#8369; <%= parseFloat(exp.amount_paid).toLocaleString('en-PH', {minimumFractionDigits:2}) %></td>
                                <td><%= exp.payment_method %></td>
                                <td><span class="payment-status <%= statusClass %>"><%= status %></span></td>
                                <td style="display:flex; gap:6px; align-items:center;">
                                    <button class="btn-icon" title="Edit" 
                                            onclick="openEditExpenseModal('<%= exp.expense_id %>', '<%= exp.amount_expected %>', '<%= exp.amount_paid %>', '<%= datePaidForm %>', '<%= exp.payment_method %>', '<%= exp.remarks %>')">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                    <button class="btn-icon btn-icon-danger" title="Delete" 
                                            onclick="confirmExpenseDelete('<%= exp.expense_id %>', '<%= exp.category %> expense')">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<div class="modal" id="modal">
    <div class="modal-content">
        <div class="modal-header"> 
            <h2>Create Payment</h2>
        </div>

        <div class="modal-body">
            <form>
                <div class="form-group">
                    <label>Payment Purpose</label>
                    <select id="purpose">
                        <option value="">Choose...</option>
                        <option value="association">Association Dues</option>
                        <option value="vehicle">Vehicle Sticker</option>
                        <option value="outstanding">Outstanding Balance</option>
                        <option value="general">General Payments</option>
                    </select>
                </div>
            </form>
        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" id="cancel"> Cancel </button>
            <button class="btn btn-primary" id="continue"> Continue </button>   
        </div>
    </div>
</div>

<div class="modal" id="expenseModal">
    <div class="modal-content">
        <div class="modal-header"> 
            <h2>Create Expense</h2>
        </div>

        <div class="modal-body">
            <form>
                <div class="form-group">
                    <label>Expense Purpose</label>
                    <select id="expensePurpose">
                        <option value="">Choose...</option>
                        <option value="utilities">Utilities</option>
                        <option value="salaries">Employee Salaries</option>
                        <option value="maintenance">Maintenance</option>
                        <option value="cash">Petty Cash</option>
                        <option value="food">Food</option>
                        <option value="project">Community Project</option>
                        <option value="other">Other</option>
                    </select>
                </div>
            </form>
        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary" id="cancelExpense"> Cancel </button>
            <button class="btn btn-primary" id="continueExpense"> Continue </button>   
        </div>
    </div>
</div>

<!-- VIEW DETAILS MODAL -->
<div class="modal" id="viewModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Payment Details</h2>
            <button class="modal-close" onclick="closeModal('viewModal')">&times;</button>
        </div>
        <div class="modal-body" id="viewModalBody"></div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('viewModal')">Close</button>
        </div>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="modal" id="editModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Edit Payment</h2>
            <button class="modal-close" onclick="closeModal('editModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form method="POST" action="/payments/update">
                <input type="hidden" name="payment_id" id="edit_payment_id">
                <input type="hidden" id="edit_payor_id">

                <div class="form-group">
                    <label>Payor <span style="font-size:11px;color:#999;">(cannot be changed)</span></label>
                    <input type="text" id="edit_payor_search" class="form-control" readonly
                           style="background:#f5f5f5; color:#888; cursor:default;">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Purpose <span style="font-size:11px;color:#999;">(cannot be changed)</span></label>
                        <input type="text" id="edit_purpose" name="purpose" class="form-control" readonly
                               style="background:#f5f5f5; color:#888; cursor:default;">
                    </div>
                    <div class="form-group">
                        <label>Amount Expected <span style="font-size:11px;color:#999;">(cannot be changed)</span></label>
                        <input type="text" id="edit_amount_expected" class="form-control" readonly
                               style="background:#f5f5f5; color:#888; cursor:default;">
                    </div>
                </div>

                <div class="form-group">
                    <label>Amount Paid (₱)</label>
                    <input type="number" name="amount_paid" id="edit_amount_paid"
                           class="form-control" step="0.01" min="0">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Date Paid</label>
                        <input type="date" name="date_paid" id="edit_date_paid" class="form-control"
                               max="<%= new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Manila' }) %>">
                    </div>
                    <div class="form-group">
                        <label>Payment Method</label>
                        <select name="payment_method" id="edit_payment_method" class="form-control">
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Check">Check</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label>Receipt Number</label>
                    <input type="text" name="receipt_number" id="edit_receipt_number" class="form-control"
                           placeholder="e.g. OR-12345">
                </div>

                <div class="form-group">
                    <label>Remarks</label>
                    <input type="text" name="remarks" id="edit_remarks" class="form-control"
                           placeholder="Optional notes">
                </div>

                <div class="modal-footer" style="padding:0; border:none; margin-top:8px;">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('editModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div class="modal" id="deleteModal">
    <div class="modal-content" style="max-width:420px;">
        <div class="modal-header">
            <h2>Delete Payment</h2>
            <button class="modal-close" onclick="closeModal('deleteModal')">&times;</button>
        </div>
        <div class="modal-body">
            <p style="font-size:14px; color:#444;">
                Are you sure you want to delete the payment for
                <strong id="deleteLabel"></strong>?
                This action cannot be undone.
            </p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('deleteModal')">Cancel</button>
            <button class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
        </div>
    </div>
</div>

<!-- EDIT EXPENSE MODAL -->
<div class="modal" id="editExpenseModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Edit Expense</h2>
            <button class="modal-close" onclick="closeModal('editExpenseModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="editExpenseForm">
                <div class="form-row">
                    <div class="form-group">
                        <label>Amount Expected (₱)</label>
                        <input type="number" name="amount_expected" id="edit_exp_amount_expected" class="form-control" step="0.01">
                    </div>
                    <div class="form-group">
                        <label>Amount Paid (₱)</label>
                        <input type="number" name="amount_paid" id="edit_exp_amount_paid" class="form-control" step="0.01">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Date Paid</label>
                        <input type="date" name="date_paid" id="edit_exp_date_paid" class="form-control">
                    </div>
                    <div class="form-group">
                        <label>Payment Method</label>
                        <select name="payment_method" id="edit_exp_payment_method" class="form-control">
                            <option value="Cash">Cash</option>
                            <option value="GCash">GCash</option>
                            <option value="Maya">Maya</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Check">Check</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Remarks</label>
                    <input type="text" name="remarks" id="edit_exp_remarks" class="form-control">
                </div>
                <div class="modal-footer" style="padding:0; border:none; margin-top:8px;">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('editExpenseModal')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DELETE EXPENSE MODAL -->
<div class="modal" id="deleteExpenseModal">
    <div class="modal-content" style="max-width:420px;">
        <div class="modal-header">
            <h2>Delete Expense</h2>
            <button class="modal-close" onclick="closeModal('deleteExpenseModal')">&times;</button>
        </div>
        <div class="modal-body">
            <p style="font-size:14px; color:#444;">Are you sure you want to delete this <strong id="deleteExpenseLabel"></strong>? This action cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="closeModal('deleteExpenseModal')">Cancel</button>
            <button class="btn btn-danger" id="confirmDeleteExpenseBtn">Delete</button>
        </div>
    </div>
</div>

<script>
    function switchTab(tabName) {
        let expensesMode = tabName === 'expenses';

        document.getElementById('paymentsSection').style.display = expensesMode ? 'none' : 'block';
        document.getElementById('expensesSection').style.display = expensesMode ? 'block' : 'none';
        
        document.getElementById('btnPaymentsTab').classList.toggle('tab-active', !expensesMode);
        document.getElementById('btnExpensesTab').classList.toggle('tab-active', expensesMode);

        document.getElementById('openModal').style.display = expensesMode ? 'none' : '';
        document.getElementById('openExpenseModal').style.display = expensesMode ? '' : 'none';

        const purposeFilter = document.getElementById('purposeFilterForm');
        if (purposeFilter) purposeFilter.style.display = expensesMode ? 'none' : 'flex';

        const titleEl = document.querySelector('.page-title');
        const subTitleEl = document.querySelector('.page-subtitle');
        if (titleEl) titleEl.textContent = expensesMode ? 'Expenses' : 'Payments';
        if (subTitleEl) subTitleEl.textContent = expensesMode
            ? 'Manage outgoing expense transactions'
            : 'Manage incoming payment transactions';

        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.value = '';
            searchInput.placeholder = expensesMode 
                ? 'Search expenses...' 
                : 'Search transactions...';
        }
    }

    document.getElementById('continueExpense').addEventListener('click', () => {
        const purpose = document.getElementById('expensePurpose').value;
        if (purpose) window.location.href = `/expenses/${purpose}`;
    });

    // expense edit and delete
    let currentExpenseId = null;

    function openEditExpenseModal(id, expected, paid, date, method, remarks) {
        currentExpenseId = id;
        document.getElementById('edit_exp_amount_expected').value = expected;
        document.getElementById('edit_exp_amount_paid').value = paid;
        document.getElementById('edit_exp_date_paid').value = date;
        document.getElementById('edit_exp_payment_method').value = method;
        document.getElementById('edit_exp_remarks').value = remarks !== 'null' ? remarks : '';
        document.getElementById('editExpenseModal').classList.add('active');
    }

    document.getElementById('editExpenseForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const formData = new URLSearchParams(new FormData(this));
        fetch(`/expenses/update/${currentExpenseId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: formData.toString()
        }).then(res => res.json()).then(data => {
            if(data.success) location.reload();
        });
    });

    function confirmExpenseDelete(id, label) {
        currentExpenseId = id;
        document.getElementById('deleteExpenseLabel').textContent = label;
        document.getElementById('deleteExpenseModal').classList.add('active');
    }

    document.getElementById('confirmDeleteExpenseBtn').addEventListener('click', function() {
        fetch(`/expenses/delete/${currentExpenseId}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => { if(data.success) location.reload(); });
    });
</script>

<script id="personData" type="application/json"><%- JSON.stringify(persons) %></script>
<script src="/js/paymentLedger.js"></script>
<script src="/js/sidebar.js"></script>